
@{
    Layout = "~/Views/Shared/_InventryLayout.cshtml";
}

<div class="row">
    <div class="card">
        <div class="card-header">
            <h4>INVOICE</h4>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <table class="table table-borderless">
                    <tr>
                        <td>
                            <label>Customer Name</label>
                            <select id="selCust" name="Customer" class="form-control">
                                <option value="">Select Customer</option>
                            </select>
                            @* <input type="text" id="txtcustname" class="form-control" /> *@
                        </td>
                        <td>
                            <label>Invoice Date</label>
                            <input type="date" id="invoicedate" name="invoicedate" class="form-control" />
                        </td>
                    </tr>
                </table>
            </div>
            <div class="mb-3">
                <table class="table table-borderless">
                    <tr>
                        <td>
                            <label>Product</label>
                            <select id="selProduct" name="Product" class="form-control">
                                <option value="">Select Product</option>
                            </select>
                            @* <input type="text" id="txtname" class="form-control"/> *@
                        </td>
                        <td>
                            <label>Rate</label>
                            <input type="text" id="txtrate" class="form-control" />
                        </td>
                        <td>
                            <label>GST</label>
                            <input type="text" id="txtgst" class="form-control" />
                        </td>
                        <td>
                            <label>Stock</label>
                            <input type="text" id="txtstock" class="form-control" />
                        </td>
                        <td>
                            <label>Quantity</label>
                            <input type="text" id="txtquantity" class="form-control" />
                        </td>
                        <td>
                            <label>Total</label>
                            <input type="text" id="txttotal" class="form-control" />
                        </td>
                        <td>
                            <label> </label>
                            <input type="button" id="btnAdd" value="+" class="btn btn-primary" onclick="AddProduct()" />
                        </td>
                    </tr>
                </table>
            </div>
            <div class="mb-3">
                <table class="table table-borderd" id="InvoiveProducts">
                    <thead>
                        <tr>
                            <th>Sr No</th>
                            <th>Product Name</th>
                            <th>Rate</th>
                            <th>GST</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="tbldata"></tbody>
                    <tfoot>
                        <tr>
                            <td colspan=5>Total</td>
                            <td id="grandTotal">0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <input type="button" id="btnsubmit" value="Submit" class="btn btn-primary" onclick="SubmitData()"/>
        </div>
    </div>
</div>
<script>
    var products = [];
    var invoiceproducts=[];
    var customers=[];

    const AddProduct = () => {

        var productselect = document.getElementById("selProduct");
         var pid = productselect.pid

        //var pid = document.getElementById("selProduct").value;
        var pname = productselect.selectedOptions[0].text;
        var rate = document.getElementById("txtrate").value;
        var gst = document.getElementById("txtgst").value;
        var quant = document.getElementById("txtquantity").value;
        var tot = document.getElementById("txttotal").value;

        console.log(pname);
        var pr = {"ProductId":pid, "ProductName": pname, "Rate": rate, "Gst":gst, "Quantity":quant, "Total":tot };
        invoiceproducts.push(pr);
        console.log(invoiceproducts);
        clearData();
        displayTable();
        
    }
    const displayTable = () => {
        var data = "";
        invoiceproducts.forEach(function(d, k) {
            data += "<tr><td>" + (k + 1) + "</td><td>" + d.ProductName + "</td><td>" + d.Rate + "</td><td>" + d.Gst + "</td><td>" + d.Quantity + "</td><td>" + d.Total + "</td></tr>"
        });
        document.getElementById("tbldata").innerHTML = data;
      calculateGrandTotal();
    }

    const calculateGrandTotal=()=>{
        const table=document.getElementById("InvoiveProducts");
        const rows=table.tBodies[0].rows;
        let sum=0;

         for(let i=0; i< rows.length;i++)
         {
             const lastCellValue=parseFloat(rows[i].cells[rows[i].cells.length-1].textContent);
             if(!isNaN(lastCellValue))
             {
                 sum+=lastCellValue;
             }
         }
         document.getElementById("grandTotal").textContent = sum.toFixed(2);
    }

    const clearData = () => {
        //document.getElementById("txtname").value = "";
        document.getElementById("txtrate").value = "";
        document.getElementById("txtgst").value = "";
        document.getElementById("txtstock").value = "";
        document.getElementById("txtquantity").value = "";
        document.getElementById("txttotal").value = "";
        document.getElementById("selProduct").selectedIndex="";
        //document.getElementById("selCust").selectedIndex="";
    }

    // Fill Dropdown

    const selectprod = document.getElementById("selProduct");
    const fetchProducts = async ()=>{
        const response = await fetch("/Product/GetProducts", {
            method: "get",
            headers: {
                "content-type": "application/json"
                   }
            });
            products = await response.json();
            console.log(products);
            products.forEach(function(d) {
                const option = document.createElement("option");
                option.value = d.productId;
                option.textContent = d.productName;
                selectprod.appendChild(option);
            });
       
    }
    fetchProducts();

    const selectcust = document.getElementById("selCust");
    const fetchCustomers = async () => {
        const response = await fetch("/Customer/GetCustomers", {
            method: "get",
            headers: {
                "content-type": "application/json"
            }
        });
        customers = await response.json();
        console.log(customers);
        customers.forEach(function(d, k) {
            const option = document.createElement("option");
            option.value = d.customerId;
            option.textContent = d.customerName + " - " + d.city + " - " +d.mobile;
            selectcust.appendChild(option);
        });

    }
    fetchCustomers();

    // =========================
    // Product Selection
    // =========================
    selectprod.addEventListener("change", function() {

        var productId = this.value;

        if (productId === "") {

            document.getElementById("txtrate").value = "";
            document.getElementById("txtgst").value = "";
            document.getElementById("txtstock").value = "";
            document.getElementById("txtquantity").value = "";
            document.getElementById("txttotal").value = "";

            return;
        }

        // Find selected product
        var product = products.find(
            p => p.productId == productId
        );

        console.log(product);

        if (product) {

            document.getElementById("txtrate").value = product.rate;
            document.getElementById("txtgst").value = product.gst;
            document.getElementById("txtstock").value = product.stockQuantity;

            document.getElementById("txtquantity").value = 1;

            calculateTotal();
        }

    });

    // =========================
    // Quantity Change
    // =========================
    document.getElementById("txtquantity").addEventListener("input", function() {

        var quantity = parseInt(this.value) || 0;
        var stock = parseInt(document.getElementById("txtstock").value) || 0;

        if (quantity > stock) {

            alert("Quantity cannot be greater than stock");

            this.value = stock;
            quantity = stock;
        }

        calculateTotal();
    });


    // =========================
    // Calculate Total
    // =========================
    const calculateTotal = () => {

        var rate = parseFloat(document.getElementById("txtrate").value) || 0;
        var gst = parseFloat(document.getElementById("txtgst").value) || 0;
        var quantity = parseInt(document.getElementById("txtquantity").value) || 0;

        // Amount without GST
        var amount = rate * quantity;

        // GST percentage
        var gstAmount = amount * gst / 100;

        // Final amount
        var total = amount + gstAmount;

        document.getElementById("txttotal").value = total.toFixed(2);
        
    };

    const SubmitData= async () =>{
        var InvoiceDetails=[];
        var InvoiceProducts=[];

        var invDet={"InvoiceDate":document.getElementByID("invoicedate").value, "InvoiceAmount":document.getElementById("grandTotal").value, "FK_CustomerId":document.getElementById("").value }


    }

</script>
